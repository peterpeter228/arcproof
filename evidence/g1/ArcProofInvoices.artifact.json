internalType\":\"uint256\",\"name\":\"amountNative\",\"type\":\"uint256\"},{\"internalType\":\"uint64\",\"name\":\"expiresAt\",\"type\":\"uint64\"},{\"internalType\":\"bytes32\",\"name\":\"termsHash\",\"type\":\"bytes32\"}],\"name\":\"createInvoice\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"invoiceId\",\"type\":\"bytes32\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"invoiceId\",\"type\":\"bytes32\"}],\"name\":\"getInvoice\",\"outputs\":[{\"components\":[{\"internalType\":\"address\",\"name\":\"merchant\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amountNative\",\"type\":\"uint256\"},{\"internalType\":\"uint64\",\"name\":\"expiresAt\",\"type\":\"uint64\"},{\"internalType\":\"bytes32\",\"name\":\"termsHash\",\"type\":\"bytes32\"},{\"internalType\":\"bool\",\"name\":\"paid\",\"type\":\"bool\"},{\"internalType\":\"address\",\"name\":\"payer\",\"type\":\"address\"},{\"internalType\":\"uint64\",\"name\":\"paidAt\",\"type\":\"uint64\"},{\"internalType\":\"uint256\",\"name\":\"paidBlockNumber\",\"type\":\"uint256\"}],\"internalType\":\"struct ArcProofInvoices.Invoice\",\"name\":\"\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"nextNonce\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"invoiceId\",\"type\":\"bytes32\"}],\"name\":\"payInvoice\",\"outputs\":[],\"stateMutability\":\"payable\",\"type\":\"function\"}],\"devdoc\":{\"errors\":{\"ReentrancyGuardReentrantCall()\":[{\"details\":\"Unauthorized reentrant call.\"}]},\"kind\":\"dev\",\"methods\":{\"createInvoice(uint256,uint64,bytes32)\":{\"params\":{\"amountNative\":\"Amount in native 18-decimal USDC units.                     Must be > 0, <= MAX_INVOICE_AMOUNT, and divisible by AMOUNT_QUANTUM.\",\"expiresAt\":\"Unix timestamp of expiry. Must be > block.timestamp                     and <= block.timestamp + MAX_LIFETIME.\",\"termsHash\":\"Opaque commitment hash. Stored verbatim; never interpreted here.\"},\"returns\":{\"invoiceId\":\"  The canonical invoice ID.\"}},\"getInvoice(bytes32)\":{\"params\":{\"invoiceId\":\"The invoice ID to look up.\"},\"returns\":{\"_0\":\"The Invoice struct.\"}},\"payInvoice(bytes32)\":{\"details\":\"Checks-effects-interactions pattern with balance integrity check.      Forwards msg.value to merchant atomically. Emits InvoicePaid only on success.      termsHash is opaque; any value (including nonzero) is accepted here.      UI-layer enforcement of termsHash semantics is the caller's responsibility.\",\"params\":{\"invoiceId\":\"The invoice ID to pay.\"}}},\"stateVariables\":{\"nextNonce\":{\"details\":\"Nonces begin at 0. Created invoices cover [0, nextNonce(merchant)).\"}},\"title\":\"ArcProofInvoices\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"AMOUNT_QUANTUM()\":{\"notice\":\"Amounts must be a multiple of 1e12 (expressible in 6-decimal microUSDC).\"},\"MAX_INVOICE_AMOUNT()\":{\"notice\":\"Maximum invoice amount: 1 USDC in native 18-decimal units.\"},\"MAX_LIFETIME()\":{\"notice\":\"Maximum lifetime of an invoice: 7 days in seconds.\"},\"createInvoice(uint256,uint64,bytes32)\":{\"notice\":\"Create a new invoice. The caller becomes the merchant.\"},\"getInvoice(bytes32)\":{\"notice\":\"Read a stored invoice. Reverts with UNKNOWN_INVOICE for missing IDs.\"},\"nextNonce(address)\":{\"notice\":\"Next unused nonce per merchant address.\"},\"payInvoice(bytes32)\":{\"notice\":\"Pay an invoice. Caller sends exact msg.value equal to amountNative.\"}},\"notice\":\"Immutable invoice-bound native-USDC payment prototype on Arc Testnet. Arc Testnet uses native USDC with 18 decimals as the gas token. Amount is in native USDC units (18 decimals), e.g. 0.20 USDC = 200000000000000000. This is a minimal prototype, not an audited or production-ready payment processor. It performs atomic forwarding: msg.value is received and forwarded to the merchant in the same transaction. The contract does not hold funds in escrow. termsHash is an opaque bytes32 field preserved verbatim. The contract never interprets or gates on its value \\u2014 that is a UI-layer concern. GRANT STATUS: Free prototype development is authorized for testnet/local scope per owner directive 2026-10-20. Grant eligibility: HOLD (independent of this scope). Do not claim grant eligibility has been established.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/ArcProofInvoices.sol\":\"ArcProofInvoices\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/\",\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"contracts/ArcProofInvoices.sol\":{\"keccak256\":\"0x9e8a352f07941c1ddc285d1a008b8dd94159617e021beb033e2fdf43c82b5074\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://911aa65f5bd85b7704c6729b214879e6c0a37ec9a2c2b47560e95cf729594c48\",\"dweb:/ipfs/QmQ38G8YdLB8AU9LHBXztmMBBLBvoqKswvADzwQUYqfEjV\"]},\"node_modules/@openzeppelin/contracts/utils/ReentrancyGuard.sol\":{\"keccak256\":\"0x11a5a79827df29e915a12740caf62fe21ebe27c08c9ae3e09abe9ee3ba3866d3\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://3cf0c69ab827e3251db9ee6a50647d62c90ba580a4d7bbff21f2bea39e7b2f4a\",\"dweb:/ipfs/QmZiKwtKU1SBX4RGfQtY7PZfiapbbu6SZ9vizGQD9UHjRA\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.28+commit.7893614a"},"language":"Solidity","output":{"abi":[{"inputs":[],"type":"error","name":"ALREADY_PAID"},{"inputs":[],"type":"error","name":"AMOUNT_NOT_DIVISIBLE"},{"inputs":[],"type":"error","name":"AMOUNT_TOO_LARGE"},{"inputs":[],"type":"error","name":"BALANCE_MISMATCH"},{"inputs":[],"type":"error","name":"EXPIRED"},{"inputs":[],"type":"error","name":"E