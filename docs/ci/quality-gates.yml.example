# INACTIVE DRAFT. Do not activate or dispatch without owner approval of runner
# entitlement and zero possible charges. App tests are synthetic/offline;
# checkout/runtime/dependency acquisition needs network. Never run untrusted PR code.
name: Manual local-only quality checks
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: arcproof-manual-quality
  cancel-in-progress: false
jobs:
  synthetic-checks:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      CI: 'true'
    steps:
      - name: Check out exactly the manually selected default-branch commit
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
          fetch-depth: 1
      - name: Set up the validated Node release
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: '24.19.0'
      - name: Install pinned Bun binary without package lifecycle scripts
        shell: bash
        run: |
          set -euo pipefail
          npm install --prefix "$RUNNER_TEMP/arcproof-bun" --ignore-scripts --no-audit --no-fund @oven/bun-linux-x64@1.4.3
          echo "$RUNNER_TEMP/arcproof-bun/node_modules/@oven/bun-linux-x64/bin" >> "$GITHUB_PATH"
      - name: Install the reviewed lockfile, with scripts disabled
        run: bun install --frozen-lockfile --ignore-scripts
      - name: Lint and typecheck, including archived helpers
        run: |
          bun run oxlint --type-aware src scripts
          bun run oxlint .
          bun run typecheck
          bun run tsc -p qa/new-independent-review/tsconfig.quality.json --noEmit
      - name: Run current synthetic suites, without UI/API servers
        run: |
          bun run vitest run
          bun run vitest run --config qa/native-settlement-review/vitest.config.ts
          bun run vitest run --config qa/new-independent-review/vitest.config.ts
          bun run vitest run --config qa/quality-gates/vitest.config.ts
      - name: Run migrated reviewer probes, without real RPC or wallets
        shell: bash
        run: |
          ARCPROOF_PROBE_OUTPUT="$RUNNER_TEMP/service-probes-results.json" bun qa/new-independent-review/service-probes.ts
          bun reviewer-tests/reviewer-safety.ts
          bun run vitest run --config qa/quality-gates/vitest.legacy.config.ts
      - name: Build, without deployment
        run: bun run vite build
      - name: Check local security boundaries over loopback only
        shell: bash
        run: |
          ARCPROOF_SECURITY_OUTPUT="$RUNNER_TEMP/arcproof-security-check" node --test qa/debug-security/boundary.test.mjs
# Deliberately no push, pull_request, pull_request_target, schedule, secrets,
# writable checkout credential, cache, artifact publication, deploy, or RPC step.
# Prior failures and current semantic migrations are disclosed in QUALITY_GATES.md.
